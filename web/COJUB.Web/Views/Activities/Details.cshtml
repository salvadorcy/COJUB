@model ActivityDetails
@{ViewData["Title"]=Model.Activity.Description;var members=(IReadOnlyList<Member>)ViewBag.Members;}
<header class="page-head"><div><span class="eyebrow">@Model.Activity.StartDate.ToString("dd MMMM yyyy")</span><h1>@Model.Activity.Description</h1><p>@Model.Enrollments.Count inscrits · @Model.PaidCount pagats · @Model.Collected.ToString("0.00 €") recaptats</p></div><div class="actions"><a class="btn" asp-controller="Reports" asp-action="Activity" asp-route-id="@Model.Activity.Id">↓ Llistat PDF</a><a class="btn" asp-action="Edit" asp-route-id="@Model.Activity.Id">Editar</a></div></header>
<section class="grid-2"><article class="card section-card"><div class="section-title"><h2>Inscripcions</h2></div><div class="table-wrap"><table><thead><tr><th>Soci</th><th>NIF</th><th>Tipus</th><th>Import</th><th>Pagat</th><th></th></tr></thead><tbody>@foreach(var e in Model.Enrollments){<tr><td><strong>@e.MemberName</strong><br/><small class="muted">@e.MemberId</small></td><td>@e.Nif</td><td>@(e.IsMember?"Soci":"No soci")</td><td>@e.Amount.ToString("0.00 €")</td><td><form method="post" asp-action="SetPaid" asp-route-id="@Model.Activity.Id" asp-route-enrollmentId="@e.Id"><input type="hidden" name="paid" value="@(!e.Paid?"true":"false")"/><button class="btn small" type="submit">@(e.Paid?"✓ Sí":"No")</button></form></td><td><form method="post" asp-action="RemoveEnrollment" asp-route-id="@Model.Activity.Id" asp-route-enrollmentId="@e.Id"><button class="btn small danger" data-confirm="Vols donar de baixa aquesta inscripció?" type="submit">Baixa</button></form></td></tr>}</tbody></table>@if(Model.Enrollments.Count==0){<div class="empty">Encara no hi ha inscripcions.</div>}</div></article>
<aside class="card section-card"><div class="section-title"><h2>Afegir soci</h2></div><form method="post" asp-action="AddEnrollment" asp-route-id="@Model.Activity.Id"><div class="field"><label for="MemberId">Soci</label><select id="MemberId" name="MemberId" class="control" required><option value="">Selecciona...</option>@foreach(var m in members){<option value="@m.Id">@m.Id · @m.Name</option>}</select></div><label class="check"><input type="checkbox" name="IsMember" value="true" checked/> Preu de soci</label><div class="field"><label for="Amount">Import</label><input id="Amount" name="Amount" class="control" type="number" step="0.01" value="@Model.Activity.MemberPrice.ToString("0.00",CultureInfo.InvariantCulture)"/></div><button class="btn primary" type="submit" style="margin-top:15px;width:100%">Afegir inscripció</button></form></aside></section>
