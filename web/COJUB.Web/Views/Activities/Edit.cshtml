@model Activity
@{var isNew=Model.Id==0;ViewData["Title"]=isNew?"Nova activitat":"Editar activitat";}
<header class="page-head"><div><span class="eyebrow">@(isNew?"Alta":"Edició")</span><h1>@(isNew?"Nova activitat":Model.Description)</h1></div><div class="actions"><a class="btn" asp-action="Index">Cancel·lar</a><button class="btn primary" type="submit" form="activity-form">Desar</button></div></header>
<form id="activity-form" class="card form-card" method="post"><div asp-validation-summary="ModelOnly"></div><div class="form-grid"><div class="field" style="grid-column:1/-1"><label asp-for="Description">Descripció</label><input class="control" asp-for="Description" maxlength="200"/><span asp-validation-for="Description"></span></div><div class="field"><label asp-for="StartDate">Data d'inici</label><input class="control" asp-for="StartDate" type="date"/></div><div class="field"><label asp-for="EndDate">Data de fi</label><input class="control" asp-for="EndDate" type="date"/></div><div class="field"><label asp-for="MemberPrice">Preu soci</label><input class="control" asp-for="MemberPrice" type="number" step="0.01"/></div><div class="field"><label asp-for="NonMemberPrice">Preu no soci</label><input class="control" asp-for="NonMemberPrice" type="number" step="0.01"/></div><label class="check"><input asp-for="Completed"/> Activitat completada</label></div></form>

