@model Member
@{var isNew=string.IsNullOrWhiteSpace(ViewBag.OriginalId as string);ViewData["Title"]=isNew?"Nou soci":"Editar soci";}
<header class="page-head"><div><span class="eyebrow">@(isNew?"Alta":"Fitxa del soci")</span><h1>@(isNew?"Nou soci":Model.Name)</h1><p>Les dades bancàries i personals només són visibles per usuaris autenticats.</p></div><div class="actions"><a class="btn" asp-action="Index">Cancel·lar</a><button class="btn primary" type="submit" form="member-form">Desar canvis</button></div></header>
<form id="member-form" class="card form-card" method="post"><div asp-validation-summary="ModelOnly"></div><div class="form-grid">
 <div class="form-section"><h2>Identificació</h2></div><div class="field"><label asp-for="Id">ID</label><input class="control" asp-for="Id" maxlength="5"/><span asp-validation-for="Id"></span></div><div class="field"><label asp-for="Nif">NIF</label><input class="control" asp-for="Nif" maxlength="10"/></div><div class="field"><label asp-for="Name">Nom</label><input class="control" asp-for="Name"/><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Sex">Sexe</label><select class="control" asp-for="Sex"><option value="">—</option><option value="H">Home</option><option value="M">Dona</option></select></div><div class="field"><label asp-for="BirthDate">Data de naixement</label><input class="control" asp-for="BirthDate" type="date"/></div><div class="field"><label asp-for="PartnerMemberId">ID soci parella</label><input class="control" asp-for="PartnerMemberId"/></div>
 <div class="form-section"><h2>Contacte</h2></div><div class="field"><label asp-for="Address">Adreça</label><input class="control" asp-for="Address"/></div><div class="field"><label asp-for="City">Població</label><input class="control" asp-for="City"/></div><div class="field"><label asp-for="PostalCode">Codi postal</label><input class="control" asp-for="PostalCode" maxlength="5"/></div><div class="field"><label asp-for="Phone">Telèfon</label><input class="control" asp-for="Phone"/></div><div class="field"><label asp-for="Mobile">Mòbil</label><input class="control" asp-for="Mobile"/></div><div class="field"><label asp-for="EmergencyPhone">Telèfon d'emergència</label><input class="control" asp-for="EmergencyPhone"/></div><div class="field"><label asp-for="Email">Correu electrònic</label><input class="control" asp-for="Email" type="email"/><span asp-validation-for="Email"></span></div>
 <div class="form-section"><h2>Administració i pagament</h2></div><div class="field"><label asp-for="JoinedOn">Data d'alta</label><input class="control" asp-for="JoinedOn" type="date"/></div><div class="field"><label asp-for="Fee">Quota</label><input class="control" asp-for="Fee" type="number" step="0.01"/></div><div class="field"><label asp-for="Iban">IBAN</label><input class="control" asp-for="Iban" maxlength="24"/></div><div class="field"><label asp-for="Bic">BIC</label><input class="control" asp-for="Bic" maxlength="15"/></div><label class="check"><input asp-for="DirectDebit"/> Pagament domiciliat</label><label class="check"><input asp-for="ReceiptPaid"/> Rebut cobrat</label><label class="check"><input asp-for="CounterPayment"/> Pagament per finestreta</label><label class="check"><input asp-for="IsInactive"/> Soci de baixa</label><div class="field" style="grid-column:1/-1"><label asp-for="Notes">Observacions</label><textarea class="control" asp-for="Notes" maxlength="2048"></textarea></div>
 </div></form>
