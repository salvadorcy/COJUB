@model IReadOnlyList<MemberListItem>
@{ViewData["Title"]="Socis";var search=(MemberSearch)ViewBag.Search;}
<header class="page-head"><div><span class="eyebrow">Base social</span><h1>Socis</h1><p>@Model.Count registres en aquesta vista.</p></div><div class="actions"><a class="btn" asp-controller="Reports" asp-action="Members">↓ PDF</a><a class="btn" asp-controller="Reports" asp-action="Labels">↓ Etiquetes</a><a class="btn primary" asp-action="Create">＋ Nou soci</a></div></header>
<form class="card filters" method="get"><div class="field grow"><label for="Query">Cerca</label><input id="Query" name="Query" class="control" value="@search.Query" placeholder="ID, nom, NIF o correu..." /></div><label class="check"><input type="checkbox" name="IncludeInactive" value="true" checked="@search.IncludeInactive"/> Mostrar baixes</label><label class="check"><input type="checkbox" name="CounterPaymentOnly" value="true" checked="@search.CounterPaymentOnly"/> Pagament finestreta</label><button class="btn" type="submit">Filtrar</button></form>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Nom</th><th>Adreça</th><th>Població</th><th>Contacte</th><th>Parella</th><th>Estat</th><th></th></tr></thead><tbody>
@foreach(var m in Model){<tr><td><strong>@m.Id</strong></td><td>@m.Name</td><td>@m.Address</td><td><span>@m.PostalCode</span> @m.City</td><td>@(m.Mobile??m.Phone)<br/><small class="muted">@m.Email</small></td><td>@m.PartnerName</td><td><span class="status @(m.IsInactive?"inactive":"")">@(m.IsInactive?"Baixa":"Actiu")</span></td><td><div class="row-actions"><a class="btn small" asp-action="Edit" asp-route-id="@m.Id">Editar</a>@if(!m.IsInactive){<form method="post" asp-action="Deactivate" asp-route-id="@m.Id"><button class="btn small danger" data-confirm="Vols donar de baixa aquest soci?" type="submit">Baixa</button></form>}</div></td></tr>}
</tbody></table>@if(Model.Count==0){<div class="empty">No s'han trobat socis amb aquests filtres.</div>}</div>

