@model AppSettings
@{ViewData["Title"]="Configuració";}
<header class="page-head"><div><span class="eyebrow">Paràmetres</span><h1>Configuració</h1><p>Dades de presentació, creditor i rebuts.</p></div><div class="actions"><button class="btn primary" type="submit" form="settings-form">Desar</button></div></header>
<form id="settings-form" class="card form-card" method="post"><div asp-validation-summary="ModelOnly"></div><div class="form-grid">
 <div class="form-section"><h2>Presentador</h2></div><div class="field"><label asp-for="Presenter">Presentador</label><input class="control" asp-for="Presenter" maxlength="255"/></div><div class="field"><label asp-for="PresenterTaxId">CIF presentador</label><input class="control" asp-for="PresenterTaxId" maxlength="10"/></div><div class="field"><label asp-for="PresenterIban">IBAN presentador</label><input class="control" asp-for="PresenterIban" maxlength="24"/></div><div class="field"><label asp-for="PresenterBic">BIC presentador</label><input class="control" asp-for="PresenterBic" maxlength="20"/></div>
 <div class="form-section"><h2>Ordenant</h2></div><div class="field"><label asp-for="Creditor">Ordenant</label><input class="control" asp-for="Creditor" maxlength="255"/></div><div class="field"><label asp-for="CreditorTaxId">CIF ordenant</label><input class="control" asp-for="CreditorTaxId" maxlength="10"/></div>
 <div class="form-section"><h2>Quotes i rebuts</h2></div><div class="field"><label asp-for="MemberFee">Quota dels socis</label><input class="control" asp-for="MemberFee" type="number" step="0.01" min="0" max="99.99"/><span asp-validation-for="MemberFee"></span></div><div class="field"><label asp-for="ReceiptSuffix">Sufix dels rebuts</label><input class="control" asp-for="ReceiptSuffix" maxlength="30"/></div><div class="field" style="grid-column:1/-1"><label asp-for="CounterReceiptText">Text del rebut de finestreta</label><textarea class="control" asp-for="CounterReceiptText" maxlength="1024"></textarea></div><label class="check" style="grid-column:1/-1"><input type="checkbox" name="updateActiveFees" value="true"/> Aplicar aquesta quota a tots els socis actius</label>
 </div></form>

