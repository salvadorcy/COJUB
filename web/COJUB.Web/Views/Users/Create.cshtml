@model UserAdminInput
@{ ViewData["Title"] = "Nou usuari"; }
<header class="page-head"><div><span class="eyebrow">Seguretat</span><h1>Nou usuari</h1><p>L'usuari rebrà els codis OTP en aquest correu.</p></div></header>
<form class="card form-card" method="post"><div asp-validation-summary="ModelOnly"></div><div class="form-grid"><div class="field"><label asp-for="DisplayName">Nom visible</label><input class="control" asp-for="DisplayName" autocomplete="name"/><span asp-validation-for="DisplayName"></span></div><div class="field"><label asp-for="Email">Correu electrònic</label><input class="control" asp-for="Email" autocomplete="email"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password">Contrasenya inicial</label><input class="control" asp-for="Password" autocomplete="new-password"/><span asp-validation-for="Password"></span></div></div><div class="actions"><a class="btn" asp-action="Index">Cancel·lar</a><button class="btn primary" type="submit">Crear usuari</button></div></form>
